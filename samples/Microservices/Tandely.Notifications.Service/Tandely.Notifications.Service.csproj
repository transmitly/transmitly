<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<TransmitlyVersion>0.4.*-*</TransmitlyVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>00ba2038-f44d-446d-94b1-f9f758435e7f</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="templates\order-shipped\email\default.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Bogus" Version="35.6.5" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageReference Include="Transmitly" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.ChannelProvider.Firebase" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.Microsoft.Extensions.DependencyInjection" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.TemplateEngine.Fluid" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.ChannelProvider.Smtp" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.ChannelProvider.Twilio" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.ChannelProvider.Infobip" Version="$(TransmitlyVersion)" />
		<PackageReference Include="Transmitly.ChannelProvider.SendGrid" Version="$(TransmitlyVersion)" />
 	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Transmitly.Samples.Shared\Transmitly.Samples.Shared.csproj" />
	  <ProjectReference Include="..\Tandely.IntegrationEvents\Tandely.IntegrationEvents.csproj" />
	</ItemGroup>

	
</Project>
